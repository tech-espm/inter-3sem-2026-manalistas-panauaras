<div class="profile-header text-center mb-4">
    <div class="profile-avatar-container mb-3">
        <img src="<%= usuario.foto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" alt="Avatar do perfil"
            class="rounded-circle shadow-sm"
            style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #fff;">
    </div>
    <h4 class="fw-bold mb-0">
        <%= usuario.nome %>
    </h4>
    <p class="text-muted small">
        <%= usuario.cargo %>
    </p>
</div>

<div class="profile-content">
    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="card border-0 bg-light p-3 h-100 text-center">
                <span class="material-symbols-outlined text-primary mb-1">monitoring</span>
                <div class="text-muted" style="font-size: 0.75rem;">Acessos Hoje</div>
                <div class="fw-bold">12</div>
            </div>
        </div>
        <div class="col-6">
            <div class="card border-0 bg-light p-3 h-100 text-center">
                <span class="material-symbols-outlined text-warning mb-1">notifications_active</span>
                <div class="text-muted" style="font-size: 0.75rem;">Alertas Tratados</div>
                <div class="fw-bold">4</div>
            </div>
        </div>
    </div>

    <div class="list-group list-group-flush rounded-3 overflow-hidden shadow-sm">
        <a href="/completar-perfil" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0">
            <span class="material-symbols-outlined me-3 text-secondary">person</span>
            Meus Dados
        </a>
        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0">
            <span class="material-symbols-outlined me-3 text-secondary">settings</span>
            Configurações
        </button>
        <a href="/logout" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 text-danger border-top">
            <span class="material-symbols-outlined me-3">logout</span>
            Sair do Sistema
        </a>
    </div>
</div>
<style>
    .list-group-item-action:hover {
      background-color: rgba(99, 102, 241, 0.05) !important;
      color: #6366f1 !important;
    }

    .list-group-item-action.text-danger:hover {
      background-color: rgba(239, 68, 68, 0.05) !important;
      color: #ef4444 !important;
    }
  </style>
