<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completar Perfil | Sistema Ambiental</title>
    <link rel="stylesheet" href="/public/css/login.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <style>
        .profile-upload {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto 20px;
            cursor: pointer;
        }

        .profile-upload img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--primary);
            transition: all 0.3s;
        }

        .profile-upload:hover img {
            opacity: 0.7;
        }

        .profile-upload .overlay-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: all 0.3s;
        }

        .profile-upload:hover .overlay-icon {
            opacity: 1;
        }

        .card-completar {
            width: 500px !important;
            padding: 40px !important;
            min-height: auto !important;
        }
    </style>
</head>

<body>

    <div class="container card-completar">
        <form id="formCompletar" enctype="multipart/form-data">
            <h1>Meus Dados</h1>
            <p>Atualize suas informações de perfil.</p>

            <div class="profile-upload" onclick="document.getElementById('inputFoto').click()">
                <img id="imgPreview"
                    src="<%= usuario.foto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                    alt="Preview da foto">
                <div class="overlay-icon">
                    <span class="material-symbols-outlined" style="font-size: 40px; color: #fff;">photo_camera</span>
                </div>
                <input type="file" id="inputFoto" name="foto" accept="image/*" style="display: none;"
                    onchange="previewImage(this)">
            </div>

            <input type="text" name="cargo" placeholder="Seu Cargo" value="<%= usuario.cargo || '' %>" required />
            <input type="tel" name="telefone" placeholder="Telefone de Contato" value="<%= usuario.telefone || '' %>"
                required />

            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="button" onclick="window.location.href='/'"
                    style="background: #ccc; border-color: #ccc; flex: 1;">Voltar</button>
                <button type="submit" style="flex: 2;">Salvar Alterações</button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imgPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.getElementById('formCompletar').onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);

            try {
                const res = await fetch('/api/auth/completar-perfil', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();

                if (res.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Perfil Completo!',
                        text: 'Bem-vindo ao sistema.',
                        confirmButtonColor: '#FF416C'
                    }).then(() => {
                        window.location.href = '/';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro',
                        text: result.mensagem,
                        confirmButtonColor: '#FF416C'
                    });
                }
            } catch (error) {
                console.error(error);
            }
        };
    </script>

</body>

</html>