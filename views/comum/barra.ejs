<!-- Top Navigation Bar -->
<header class="topbar">
  <div class="topbar-left">
    <div class="topbar-logo">
      <span class="material-symbols-outlined topbar-logo-icon">
        local_hospital
      </span>
    </div>
    <div>
      <h2 class="topbar-title">Asclépio</h2>
      <p class="topbar-subtitle">Monitoramento em Tempo Real</p>
    </div>
  </div>

  <div class="topbar-right">

    <div class="topbar-actions">
      <button class="icon-button">
        <span class="material-symbols-outlined">notifications</span>
      </button>
      <div class="avatar-wrapper">
        <a href="#" data-bs-toggle="modal" data-bs-target="#modalPerfil" onclick="carregarPerfil()">
          <img id="imgPreview" src="<%= usuario.foto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
            alt="Avatar do perfil do usuário" />
        </a>
      </div>
    </div>
  </div>
</header>